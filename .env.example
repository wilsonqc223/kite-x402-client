# kx402 / kx402-mcp read their configuration from the environment.
#
# Copy this file to .env, fill in what you need, and load it for one shell:
#
#     set -a; . ./.env; set +a
#
# .env is ignored by git in this repository. Never commit a real key.

# The paying wallet's private key: 64 hex characters, with or without 0x.
# Needed by `kx402 pay` and by the MCP server's kx402_pay. Leave it unset for
# read-only use (probe, receipt, `pay -dry-run`, and the MCP server's
# kx402_probe / kx402_inspect / kx402_balance all work without it).
# `pay`, `wallet` and `balance` also take -key-file PATH instead; a file that
# other users can read is refused, so keep it at mode 600.
# KITE_PRIVATE_KEY=0x...

# Per-payment price cap in USD. A challenge priced above it is refused before
# anything is signed. "0" disables the cap. Default: 1.
# `kx402 pay` takes -max-usd per call; the MCP server reads only this
# variable, so it is the one cap an agent cannot change.
# KITE_MAX_PAYMENT_USD=1

# Network used by `kx402 balance` when -net is not given: testnet or mainnet.
# Default: testnet.
# KITE_NETWORK=testnet

# Egress proxy for the MCP server kx402-mcp, for every request it makes.
# The CLI takes -proxy URL per command instead.
# KITE_PROXY=socks5://127.0.0.1:10800
